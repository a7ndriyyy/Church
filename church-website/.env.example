# Copy this file to .env and fill in the values.

# Supabase → Project Settings → API Keys (publishable key, never the secret one)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Stripe → Payment Links → create a link with "Customers choose what to pay"
REACT_APP_STRIPE_DONATION_LINK=https://donate.stripe.com/your-link
